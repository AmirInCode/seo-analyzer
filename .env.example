# ─── Groq (پیش‌فرض: رایگان و بسیار سریع) ───
# کلید رایگان را از https://console.groq.com/keys بگیرید:
GROQ_API_KEY=

AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# اگر پشت فیلترشکن/پروکسی هستید، آدرس پروکسی را اینجا بگذارید (مثال v2ray/xray):
# AI_PROXY=http://127.0.0.1:10808

# پورت سرور (اختیاری)
PORT=3000


# ─── گزینه‌های دیگر (سازگار با OpenAI) ───
# Ollama محلی (بدون کلید، آفلاین):
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=qwen3:8b
#
# NVIDIA:
#   NVIDIA_API_KEY=nvapi-...
#   AI_BASE_URL=https://integrate.api.nvidia.com/v1
#   AI_MODEL=z-ai/glm-5.2
