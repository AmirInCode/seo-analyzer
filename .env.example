# ─── تنظیمات هوش مصنوعی (سازگار با OpenAI) ───
# کلید API خود را اینجا بگذارید (این مقدار را در گیت کامیت نکنید):
AI_API_KEY=

# endpoint سازگار با OpenAI — پیش‌فرض روی واسط gapgpt است.
AI_BASE_URL=https://api.gapgpt.app/v1
AI_MODEL=gpt-5-mini

# سقف‌های اختیاری (در صورت نیاز تغییر دهید):
# AI_MAX_BODY_CHARS=10000
# AI_MAX_TOKENS=3500

# پورت سرور (اختیاری)
PORT=3000


# ─── گزینه‌های دیگر (سازگار با OpenAI) ───
# Groq (رایگان و سریع):
#   AI_API_KEY=gsk_...
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
#
# Ollama محلی (بدون کلید، آفلاین):
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=qwen3:8b
